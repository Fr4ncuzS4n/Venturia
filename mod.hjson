#the mod name as displayed in-game
displayName: "Venturia"

#the internal name of your mod
#this is the prefix of all content names, bundle keys and sprite regions
name: "venturia"

#your name
author: "Fr4ncuz"

#the fully qualified main class of the mod
main: "venturia.VenturiaMod"

#the mod description as seen in the mod dialog
description: "Adds a third planet to Mindustry, where the wind is the main source of power."

#the mod version
version: 0.1.0

#the minimum game build required to run this mod
minGameVersion: 160.3

#this is a java mod
java: true
